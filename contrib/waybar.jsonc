// dictator waybar module. Add "custom/dictator" to modules-right (e.g. just
// before "privacy") and merge this definition into the config. The client
// streams one JSON line per state change and reconnects by itself while the
// daemon is down, so there is no polling; "alt" picks the icon and "class"
// drives the CSS in waybar.css.
{
    "custom/dictator": {
        "exec": "dictator watch -format waybar",
        "return-type": "json",
        "restart-interval": 2,
        // A fixed prefix so this is not mistaken for the privacy/pulseaudio mic
        // icons: md-crown (U+F01A5), because dictator. Other candidates:
        // 󱌈 md-account_tie_voice, 󰼭 md-typewriter, 󰃦 md-bullhorn.
        "format": "󰆥 {icon}",
        // Nerd Font glyphs (Material Design set, present in Hack Nerd Font):
        // type=md-microphone notes=md-notebook_edit idle=md-microphone_off
        // starting=md-timer_sand down=md-microphone_question
        "format-icons": {
            "type": "󰍬",
            "notes": "󱓧",
            "idle": "󰍭",
            "starting": "󰔟",
            "down": "󱦉"
        },
        "escape": true,
        "tooltip": true,
        "on-click": "dictator -notify toggle type",
        "on-click-right": "dictator -notify toggle notes"
    }
}
