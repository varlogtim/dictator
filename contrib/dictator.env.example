# dictatord configuration (systemd EnvironmentFile: KEY=VALUE, no quotes
# needed unless the value has spaces). Every setting is also a flag; run
# `dictatord -h` for the full list and defaults. Installed to
# ~/.config/dictator/dictator.env; `systemctl --user restart dictator` after
# editing.

# Where notes-mode files go (one file per session, named by start time).
#DICTATOR_NOTES_DIR=/home/tim/notes/dictation

# Model locations (defaults match `make models`).
#DICTATOR_MODEL_DIR=/home/tim/.local/share/dictator/models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
#DICTATOR_VAD_MODEL=/home/tim/.local/share/dictator/models/silero_vad.onnx

# Recognizer threads. 4 was the sweet spot on a 6-core Ryzen (6 gave nothing).
#DICTATOR_THREADS=4

# Capture command: anything that writes 16 kHz mono s16le PCM to stdout.
#DICTATOR_RECORD_CMD=pw-record --rate 16000 --channels 1 --format s16 -

# Typing tool and behaviour for "type" mode.
#DICTATOR_TYPE_CMD=wtype
#DICTATOR_TYPE_SUFFIX=" "
# Some apps drop synthetic keystrokes that arrive too fast; try 5-10 ms.
#DICTATOR_TYPE_DELAY_MS=0

# Utterance segmentation (seconds). Lower MIN_SILENCE = snappier but choppier.
#DICTATOR_VAD_THRESHOLD=0.5
#DICTATOR_VAD_MIN_SILENCE=0.4
#DICTATOR_VAD_MIN_SPEECH=0.25
#DICTATOR_VAD_MAX_SPEECH=15

# debug logs every utterance: journalctl --user -u dictator -f
#DICTATOR_LOG_LEVEL=info
